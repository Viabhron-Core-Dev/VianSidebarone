<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <!-- Display Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom|end"
        android:orientation="vertical"
        android:paddingTop="1dp"
        android:paddingBottom="2dp">

        <!-- Top Display (Full calculation expression with cursor) -->
        <HorizontalScrollView
            android:id="@+id/scroll_expression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:fillViewport="true">

            <TextView
                android:id="@+id/tv_expression"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:textColor="#9E9E9E"
                android:textSize="15sp"
                android:fontFamily="sans-serif-light"
                android:lines="1"
                android:singleLine="true" />
        </HorizontalScrollView>

        <!-- Bottom Display (Active result / calculation, auto-scaled with Copy Result button) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_copy_result"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="6dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:src="@android:drawable/ic_menu_save"
                android:tint="#80D8FF"
                android:contentDescription="@string/calculator_copy_result" />

            <HorizontalScrollView
                android:id="@+id/scroll_result"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:scrollbars="none"
                android:fillViewport="true">

                <TextView
                    android:id="@+id/tv_result"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif"
                    android:lines="1"
                    android:singleLine="true" />
            </HorizontalScrollView>
        </LinearLayout>
    </LinearLayout>

    <!-- Extended Functions Toggle Bar (Drawer Handle) -->
    <LinearLayout
        android:id="@+id/btn_toggle_drawer"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackground"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_drawer_arrow"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@android:drawable/arrow_down_float"
            android:tint="#757575"
            android:contentDescription="Toggle Extended Options" />
    </LinearLayout>

    <!-- Extended Drawer Options (Non-scientific utility panel + Cursor navigation arrows) -->
    <LinearLayout
        android:id="@+id/layout_extended_drawer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginBottom="1dp">

            <TextView
                android:id="@+id/btn_cursor_left"
                style="@style/CalcBtnSmall"
                android:text="◀"
                android:textColor="#80D8FF" />

            <TextView
                android:id="@+id/btn_cursor_right"
                style="@style/CalcBtnSmall"
                android:text="▶"
                android:textColor="#80D8FF" />

            <TextView
                android:id="@+id/btn_paren_open"
                style="@style/CalcBtnSmall"
                android:text="("
                android:textColor="#B0BEC5" />

            <TextView
                android:id="@+id/btn_paren_close"
                style="@style/CalcBtnSmall"
                android:text=")"
                android:textColor="#B0BEC5" />

            <TextView
                android:id="@+id/btn_power"
                style="@style/CalcBtnSmall"
                android:text="^"
                android:textColor="#B0BEC5" />

            <TextView
                android:id="@+id/btn_sqrt"
                style="@style/CalcBtnSmall"
                android:text="√"
                android:textColor="#B0BEC5" />
        </TableRow>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="2dp"
            android:background="#26FFFFFF" />
    </LinearLayout>

    <!-- Keypad Grid (Standard Numbers & Operators) -->
    <TableLayout
        android:id="@+id/tableLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stretchColumns="*">

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginBottom="2dp">
            <TextView android:text="C" style="@style/CalcBtn" android:textColor="#FF7043"/>
            <TextView android:text="DEL" style="@style/CalcBtn" android:textColor="#FF7043"/>
            <TextView android:text="%" style="@style/CalcBtn" android:textColor="#FF7043"/>
            <TextView android:text="÷" style="@style/CalcBtn" android:textColor="#FF7043"/>
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginBottom="2dp">
            <TextView android:text="7" style="@style/CalcBtn"/>
            <TextView android:text="8" style="@style/CalcBtn"/>
            <TextView android:text="9" style="@style/CalcBtn"/>
            <TextView android:text="x" style="@style/CalcBtn" android:textColor="#FF7043"/>
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginBottom="2dp">
            <TextView android:text="4" style="@style/CalcBtn"/>
            <TextView android:text="5" style="@style/CalcBtn"/>
            <TextView android:text="6" style="@style/CalcBtn"/>
            <TextView android:text="-" style="@style/CalcBtn" android:textColor="#FF7043"/>
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginBottom="2dp">
            <TextView android:text="1" style="@style/CalcBtn"/>
            <TextView android:text="2" style="@style/CalcBtn"/>
            <TextView android:text="3" style="@style/CalcBtn"/>
            <TextView android:text="+" style="@style/CalcBtn" android:textColor="#FF7043"/>
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="38dp">
            <TextView android:text="0" style="@style/CalcBtn"/>
            <TextView android:text="00" style="@style/CalcBtn"/>
            <TextView android:text="." style="@style/CalcBtn"/>
            <TextView
                android:text="="
                style="@style/CalcBtn"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="@drawable/calc_eq_bg"/>
        </TableRow>

    </TableLayout>

</LinearLayout>
