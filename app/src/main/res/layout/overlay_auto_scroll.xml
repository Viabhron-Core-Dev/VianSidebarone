<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_auto_scroll_pill"
    android:padding="8dp"
    android:elevation="8dp"
    android:gravity="center">

    <ImageView
        android:id="@+id/iv_scroll_indicator"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="8dp"
        android:src="@android:drawable/ic_dialog_info"
        android:contentDescription="Scroll Indicator" />

    <ImageButton
        android:id="@+id/btn_slower"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@android:drawable/ic_media_rew"
        android:background="?android:attr/selectableItemBackground"
        android:contentDescription="Slower" />

    <ImageButton
        android:id="@+id/btn_pause_play"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@android:drawable/ic_media_pause"
        android:background="?android:attr/selectableItemBackground"
        android:contentDescription="Pause/Play" />

    <ImageButton
        android:id="@+id/btn_faster"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@android:drawable/ic_media_ff"
        android:background="?android:attr/selectableItemBackground"
        android:contentDescription="Faster" />

    <View
        android:layout_width="1dp"
        android:layout_height="30dp"
        android:layout_marginHorizontal="8dp"
        android:background="#444444" />

    <ImageButton
        android:id="@+id/btn_exit"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:background="?android:attr/selectableItemBackground"
        android:contentDescription="Exit" />

</LinearLayout>
